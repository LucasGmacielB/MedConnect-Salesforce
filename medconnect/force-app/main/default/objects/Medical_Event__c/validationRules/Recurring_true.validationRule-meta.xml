<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recurring_true</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Recurring__c = TRUE,
    ISBLANK(TEXT(Frequency__c))
)</errorConditionFormula>
    <errorMessage>A frequência é obrigatória quando a opção Recorrente está selecionada.</errorMessage>
</ValidationRule>
