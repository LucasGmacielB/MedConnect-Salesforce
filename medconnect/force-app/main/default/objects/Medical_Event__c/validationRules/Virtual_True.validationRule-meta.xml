<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Virtual_True</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Event_Type__c, &quot;Virtual&quot;),
    NOT(ISBLANK(Address__c))

)</errorConditionFormula>
    <errorMessage>O local deve estar vazio para eventos virtuais.</errorMessage>
</ValidationRule>
